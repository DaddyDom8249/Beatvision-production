{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"beatvision",
  "main":"src/index.ts",
  "compatibility_date":"2026-09-24",
  "assets":{"directory":"./public","binding":"ASSETS","not_found_handling":"single-page-application"},
  "ai":{"binding":"AI"},
  "d1_databases":[{"binding":"DB","database_name":"beatvision","database_id":"REPLACE_WITH_D1_DATABASE_ID"}],
  "r2_buckets":[{"binding":"MEDIA","bucket_name":"beatvision-media"}],
  "secrets":{"required":["PIXAZO_API_KEY","SHOTSTACK_API_KEY"]}
}