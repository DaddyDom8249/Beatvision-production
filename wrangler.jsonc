{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"beatvision-production",
  "main":"src/index.ts",
  "compatibility_date":"2026-09-25",
  "workers_dev":true,
  "assets":{"directory":"./public","binding":"ASSETS","not_found_handling":"single-page-application"},
  "ai":{"binding":"AI"},
  "d1_databases":[{"binding":"DB","database_name":"beatvision","database_id":"869a2f6b-02e0-4f86-8d71-64c7fb8378f6"}],
  "secrets":{"required":["PIXAZO_API_KEY","SHOTSTACK_API_KEY"]},
  "observability":{"logs":{"enabled":true,"head_sampling_rate":1,"invocation_logs":true,"persist":true},"traces":{"enabled":true,"head_sampling_rate":1,"persist":true}}
}
